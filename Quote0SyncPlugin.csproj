<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDynamicLoading>True</EnableDynamicLoading>
    <CreateCipx>true</CreateCipx>
    <AssemblyName>Quote0SyncPlugin</AssemblyName>
    <RootNamespace>Quote0SyncPlugin</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <!-- 插件发布配置 -->
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>

    <!-- 优化包大小 -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <!-- 开发期引用本地核心库以使用最新 API；
         待相关 API 随 ClassIsland 发布后，请切换为 ClassIsland.PluginSdk 包引用。
         所有引用均不复制到输出目录，避免与主程序已加载的程序集冲突。 -->
    <ProjectReference Include="..\ClassIsland.Core\ClassIsland.Core.csproj"
                      Private="false"
                      ExcludeAssets="runtime" />
    <ProjectReference Include="..\ClassIsland.Shared\ClassIsland.Shared.csproj"
                      Private="false"
                      ExcludeAssets="runtime" />
    <ProjectReference Include="..\ClassIsland.Shared.IPC\ClassIsland.Shared.IPC.csproj"
                      Private="false"
                      ExcludeAssets="runtime" />
    <ProjectReference Include="..\ClassIsland.Platforms.Abstractions\ClassIsland.Platforms.Abstractions.csproj"
                      Private="false"
                      ExcludeAssets="runtime" />
  </ItemGroup>

  <Import Project="..\ClassIsland.PluginSdk\ClassIsland.PluginSdk.targets" />

  <!-- 本地项目引用开发模式下，Avalonia 等传递依赖的 native 资产会进入输出目录。
       运行时由主程序提供这些库，这里在打包 cipx 前清理，保持插件输出干净。 -->
  <Target Name="CleanPluginRuntimeAssets" BeforeTargets="CreateCipx">
    <RemoveDir Directories="$(OutputPath)runtimes" Condition="Exists('$(OutputPath)runtimes')" />
  </Target>

  <ItemGroup>
    <None Update="icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="manifest.yml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="README.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
